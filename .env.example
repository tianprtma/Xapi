# ═══════════════════════════════════════════════════════════════
# Xapi proxy — contoh konfigurasi (.env)
# Salin jadi .env, isi nilai sesuai kebutuhan.
# Semua variabel opsional kecuali disebut lain.
# ═══════════════════════════════════════════════════════════════

# ── Keamanan (WAJIB diset untuk production) ──────────────────────
# Token admin utk endpoint /admin/stats, /cache/stats, /tid/stats.
# Generate: openssl rand -hex 32. Kosong = endpoint disembunyikan.
ADMIN_TOKEN=

# 1 = terima auth_token via query string ?auth_token= (dev only — bocor
# di log). 0 = hanya header Authorization (WAJIB 0 di production).
ALLOW_QUERY_AUTH=1

# 1 = izinkan ?raw=1 (respons mentah upstream). 0 utk production.
ENABLE_RAW=1

# Origin yang diizinkan (CORS). Pisah koma.
# ALLOWED_ORIGINS=

# ── Jaringan ─────────────────────────────────────────────────────
# Host bind server (127.0.0.1 = lokal saja; 0.0.0.0 = semua interface).
API_HOST=127.0.0.1

# Proxy upstream utk panggilan API ke x.com — dipisah koma, dirotasi
# deterministik per token (akun yang sama selalu lewat IP yang sama).
# Format: http://host:port | http://user:pass@host:port | socks5://...
# Media (download foto/video di bot, upload notifikasi) TIDAK lewat proxy.
# PROXY_LIST=http://user:pass@proxy1:port,http://user:pass@proxy2:port

# Upload media langsung tanpa proxy (hemat kuota — video bisa puluhan MB).
# 0 = upload ikut jalur proxy.
MEDIA_PROXY_EXEMPT=1

# ── Koneksi & pool ───────────────────────────────────────────────
# Jumlah maksimal session curl_cffi per token yang di-pool.
# CLIENT_POOL_MAX=100
# Detik idle sebelum session pool di-evict.
# CLIENT_POOL_TTL=600

# ── Retry upstream (429/5xx) ─────────────────────────────────────
# Jumlah percobaan / delay awal / delay maksimum (detik, eksponensial+jitter).
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=8

# ── Request & cache ──────────────────────────────────────────────
# Batas ukuran body request (bytes) — endpoint media upload punya cap
# terpisah MEDIA_UPLOAD_MAX_BYTES (default 50 MB).
# MAX_BODY_SIZE=1048576
# TTL cache respons baca (detik).
# RESPONSE_CACHE_TTL=60
# Jumlah worker uvicorn.
# WEB_CONCURRENCY=1

# ── XChat bridge (opsional) ──────────────────────────────────────
# XCHAT_BOT_USER_ID=
