# ═══════════════════════════════════════════════════════════════
# Xapi proxy — contoh konfigurasi (.env)
# Salin jadi .env, isi nilai sesuai kebutuhan.
# Semua variabel opsional kecuali disebut lain.
# ═══════════════════════════════════════════════════════════════

# ── Keamanan (WAJIB diset untuk production) ──────────────────────
# Token admin untuk endpoint /admin/stats, /cache/stats, /tid/stats.
# Generate: openssl rand -hex 32. Kosong = endpoint disembunyikan (404).
ADMIN_TOKEN=

# 1 = terima auth_token via query string ?auth_token= (praktis untuk
#     testing, TAPI token bocor di access log/history).
# 0 = hanya header Authorization: Bearer (WAJIB 0 di production).
ALLOW_QUERY_AUTH=1

# 1 = izinkan ?raw=1 (respons mentah GraphQL upstream, untuk debugging).
# 0 = matikan di production (mengurangi permukaan data yang terekspos).
ENABLE_RAW=1

# Origin yang diizinkan (CORS), pisah koma. Kosong = default ketat.
# ALLOWED_ORIGINS=https://domainkamu.com

# 1 = header CSP ketat di semua respons. 0 = longgar (default).
# STRICT_CSP=0

# ── Jaringan ─────────────────────────────────────────────────────
# Host bind server:
#   127.0.0.1 = hanya lokal (direkomendasikan; akses remote via reverse proxy)
#   0.0.0.0   = semua interface (hanya jika firewall membatasi)
API_HOST=127.0.0.1

# Proxy upstream untuk panggilan API ke x.com — dipisah koma.
# Dipakai deterministik per token: akun yang sama selalu lewat IP sama.
# Format: http://host:port | http://user:pass@host:port | socks5://...
# Media TIDAK lewat proxy (download foto/video di bot dan upload
# notifikasi langsung — hemat kuota proxy; lihat MEDIA_PROXY_EXEMPT).
# PROXY_LIST=http://user:pass@proxy1:port,http://user:pass@proxy2:port

# 1 = upload media ke upload.x.com LANGSUNG tanpa proxy (hemat kuota —
#     video bisa puluhan MB). Fallback otomatis ke proxy bila direct gagal.
# 0 = upload ikut jalur proxy.
MEDIA_PROXY_EXEMPT=1

# ── Koneksi & pool session ───────────────────────────────────────
# Jumlah maksimal session curl_cffi yang di-pool per token.
# Tiap session impersonate Chrome (~5-15 MB RAM). Untuk 3-5 token crawl,
# 10-20 sudah lebih dari cukup.
# CLIENT_POOL_MAX=50

# Detik idle sebelum session di-pool di-evict (lebih kecil = hemat RAM).
# CLIENT_POOL_TTL=600

# ── Retry upstream (429/5xx) ─────────────────────────────────────
# Jumlah percobaan maksimal per panggilan GraphQL/REST.
# RETRY_MAX_ATTEMPTS=3
# Delay awal backoff (detik) — tumbuh eksponensial + jitter 25%.
# RETRY_BASE_DELAY=0.5
# Batas atas delay backoff (detik).
# RETRY_MAX_DELAY=8

# ── Request & cache ──────────────────────────────────────────────
# Batas ukuran body request (bytes). Endpoint media upload punya cap
# terpisah MEDIA_UPLOAD_MAX_BYTES (default 50 MB).
# MAX_BODY_SIZE=1048576

# Cap ukuran body upload media (bytes) — video notifikasi bisa besar.
# MEDIA_UPLOAD_MAX_BYTES=52428800

# TTL cache respons baca (detik) — mengurangi panggilan ulang ke X.
# RESPONSE_CACHE_TTL=30

# ── Rate limit per token (proteksi abuse API) ────────────────────
# Request per jendela per auth_token.
# RATE_LIMIT_PER_TOKEN=100
# Ukuran bucket token.
# RATE_LIMIT_MAX_TOKENS=10000
# Burst awal bucket.
# RATE_LIMIT_BURST=200

# ── Server & logging ─────────────────────────────────────────────
# Jumlah worker uvicorn (naikkan jika CPU > 1 core dan trafik tinggi).
# WEB_CONCURRENCY=1
# Level log: DEBUG | INFO | WARNING | ERROR.
# LOG_LEVEL=INFO

# ── XChat bridge (opsional) ──────────────────────────────────────
# User ID akun bot untuk bridge XChat (dekripsi OPFS chat.db).
# XCHAT_BOT_USER_ID=
