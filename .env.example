# ═══════════════════════════════════════════════════════════════
# Xapi — contoh konfigurasi (.env)
# Salin jadi .env. SEMUA variabel opsional — default aman sudah jalan.
# Satu variabel = satu entri penjelasan di bawah.
# ═══════════════════════════════════════════════════════════════

# ────────────────────────── KEAMANAN ──────────────────────────

# ADMIN_TOKEN=<64 hex>
# Kunci endpoint /admin/stats (X-Admin-Token header). Isinya statistik infra:
# session cache, TID provider, client pool, response cache, rate limiter,
# xchat_context_pool, route inventory.
# Generate: openssl rand -hex 32
# KOSONG (default) = endpoint disembunyikan (404) — tidak bocor info internal.
ADMIN_TOKEN=

# ALLOW_QUERY_AUTH=1
# 1 = terima auth_token via query string ?auth_token=… (praktis untuk testing).
# 0 = hanya header Authorization: Bearer.
# PENTING: query string tercatat penuh di access log uvicorn & reverse proxy —
# token di situ = full akun. WAJIB 0 di production.
ALLOW_QUERY_AUTH=1

# ENABLE_RAW=1
# 1 = izinkan ?raw=1 (respons mentah GraphQL upstream, bisa berisi cookie,
# untuk debugging formatter). 0 = matikan di production.
ENABLE_RAW=1

# ALLOWED_ORIGINS=https://domainkamu.com,https://domainkedua.com
# CORS allowlist, pisah koma. Hanya origin ini yang boleh memanggil API
# dari browser lintas domain. KOSONG (default) = tidak ada header CORS
# (akses via curl/server-side tetap jalan normal).
# ALLOWED_ORIGINS=

# STRICT_CSP=0
# 1 = Content-Security-Policy ketat (tanpa inline script/font eksternal).
# 0 = CSP longgar (docs-ui dev mode butuh inline). Production tanpa docs-ui
# di depan publik boleh set 1.
# STRICT_CSP=0

# ────────────────────────── JARINGAN / SERVER ──────────────────────────

# API_HOST=127.0.0.1
# Host bind uvicorn (dipakai saat `python3 main.py`).
# 127.0.0.1 = hanya lokal — akses eksternal via SSH tunnel / reverse proxy
# (direkomendasikan). 0.0.0.0 = semua interface, WAJIB firewall ketat.
API_HOST=127.0.0.1

# PROXY_LIST=http://user:pass@proxy1:port,http://user:pass@proxy2:port
# Proxy upstream untuk panggilan ke x.com — sticky per token (akun yang sama
# selalu keluar lewat IP yang sama). Format: http://… | socks5://…
# KOSONG (default) = direct. CATATAN 5 Nov 2026: proxy scrapegw balas 407
# CONNECT — kalau proxy mati, KOSONKAN; jangan biarkan terisi (semua request
# 500/407).
# PROXY_LIST=

# MEDIA_PROXY_EXEMPT=1
# 1 = upload/download media (upload.x.com, bisa puluhan MB) LANGSUNG tanpa
# proxy — hemat kuota proxy. Fallback otomatis ke proxy bila direct gagal.
# 0 = media ikut jalur proxy.
MEDIA_PROXY_EXEMPT=1

# WEB_CONCURRENCY=1
# Jumlah worker uvicorn. CACHE (session/response/pool) TIDAK dibagi antar
# worker — naikkan hanya jika trafik tinggi & sadar cache terduplikasi.
# WEB_CONCURRENCY=1

# LOG_LEVEL=INFO
# Level log JSON: DEBUG | INFO | WARNING | ERROR.
# LOG_LEVEL=INFO

# ────────────────────────── PLAYWRIGHT (browser) ──────────────────────────

# PLAYWRIGHT_ENABLED=1
# Master switch Chromium: ambil DM XChat E2EE (dm_pin), search fallback,
# TID via browser, resolve profil. WAJIB 1 bila ingin fitur E2EE.
# 0 (default) = tanpa Chromium (DM biasa REST/GraphQL tetap jalan).
# Butuh: playwright install chromium (~300MB RAM saat aktif).
PLAYWRIGHT_ENABLED=0

# PLAYWRIGHT_MAX_CONCURRENT=1
# Halaman browser aktif paralel. Setiap halaman ~80-150MB; di luar limit
# antri di semaphore.
# PLAYWRIGHT_MAX_CONCURRENT=1

# PLAYWRIGHT_FALLBACK=0
# 1 = endpoint /2/users/{id} boleh jatuh ke Playwright saat GraphQL gagal
# DAN tidak ada cache profil snapshot. Default 0 (hemat RAM — hanya cache).
# PLAYWRIGHT_FALLBACK=0

# ────────────────────────── XCHAT E2EE (PIN) ──────────────────────────

# XCHAT_PROFILE_DIR=/path/ke/.xchat_profiles
# Induk direktori profil browser persist per akun — menyimpan cookie sesi +
# kunci E2EE di disk, sehingga PIN tidak diketik ulang tiap run.
# Default: <repo>/.xchat_profiles (sudah di-gitignore).
# PERINGATAN: isi direktori = kredensial; lindungi, jangan commit.
# XCHAT_PROFILE_DIR=

# XCHAT_PERSISTENT_MAX=3
# Max profil/context persist aktif bersamaan (LRU; idle di-evict — aman,
# unlock state ada di disk). Setiap context = 1 process Chromium.
# XCHAT_PERSISTENT_MAX=3

# ────────────────────────── KONEKSI & POOL ──────────────────────────

# CLIENT_POOL_MAX=50
# Max session curl_cffi di-pool per token (tiap session impersonate Chrome,
# ~5-15MB RAM). Untuk 3-5 token, 10-20 cukup.
# CLIENT_POOL_MAX=50

# CLIENT_POOL_TTL=600
# Detik idle sebelum session di-pool di-evict (cookie jangan terlalu lama
# dipakai ulang; evict menutup session dengan aman bila idle).
# CLIENT_POOL_TTL=600

# ────────────────────────── RETRY UPSTREAM ──────────────────────────

# RETRY_MAX_ATTEMPTS=3
# Percobaan maksimal per panggilan GraphQL/REST (hanya error 429/502/503/504;
# exception jaringan tidak di-retry).
# RETRY_MAX_ATTEMPTS=3

# RETRY_BASE_DELAY=0.5
# Delay backoff awal (detik). Tumbuh 2^(attempt-1), ±25% jitter.
# RETRY_BASE_DELAY=0.5

# RETRY_MAX_DELAY=8
# Batas atas backoff (detik).
# RETRY_MAX_DELAY=8

# ────────────────────────── REQUEST & CACHE ──────────────────────────

# MAX_BODY_SIZE=1048576
# Cap body request non-media (bytes) — default 1MB.
# MAX_BODY_SIZE=1048576

# MEDIA_UPLOAD_MAX_BYTES=52428800
# Cap body khusus /2/media/upload* (bytes) — video bisa besar. Default 50MB.
# MEDIA_UPLOAD_MAX_BYTES=52428800

# RESPONSE_CACHE_TTL=30
# TTL cache respons baca (detik), hanya opsi read-only yang aman.
# 0 = cache mati. Respons error TIDAK di-cache.
# RESPONSE_CACHE_TTL=30

# ────────────────────────── RATE LIMIT (API sendiri) ──────────────────────────

# RATE_LIMIT_PER_TOKEN=100
# Token bucket per auth_token: refill 100 request/detik.
# RATE_LIMIT_PER_TOKEN=100

# RATE_LIMIT_BURST=200
# Burst awal bucket (request beruntun sebelum 429).
# RATE_LIMIT_BURST=200

# RATE_LIMIT_MAX_TOKENS=10000
# Max bucket yang dilacak (LRU — anti memory exhaustion dari token spam).
# RATE_LIMIT_MAX_TOKENS=10000

# ────────────────────────── SCRIPT & INTEGRASI ──────────────────────────

# TEST_AUTH_TOKEN=<40 hex>
# Token default fetch_dm_pin.py (bisa ditimpa --token). TIDAK dibaca server.
# TEST_AUTH_TOKEN=

# DM_PIN=110999
# PIN default fetch_dm_pin.py (bisa ditimpa --pin). TIDAK dibaca server.
# CATATAN: jangan commit nilai aslinya; produksi via API pakai header X-DM-Pin.
# DM_PIN=

# XCHAT_BOT_USER_ID=<user id>
# User ID akun bot untuk fitur bridge XChat (opsional, belum aktif).
# XCHAT_BOT_USER_ID=

# BOT_DB_PATH=/opt/jkt48history/data/bot.db
# SQLite snapshot profil (read-only) — fallback jawaban /2/users/{id} saat
# UserByRestId gagal & tidak ada Playwright. Kosongkan path kalau tidak ada.
# BOT_DB_PATH=
