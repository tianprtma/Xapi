# ══════════════════════════════════════════════════════════════════════
# XAPI SERVER — .env untuk project menfessllm
# Bot LLM menfess (akun vvotanet): baca mention/DM ⯈ LLM ⯈ posting/balas,
# termasuk kiriman menfess via DM XChat E2EE.
#
# Pakai di VPS (/opt/Xapi):
#   cp .env .env.bak.$(date +%s) 2>/dev/null || true     # backup dulu
#   cp deploy/env.menfessllm.example .env
#   nano .env        # isi 3 TODO di bawah
#   systemctl restart xapi && curl -s http://127.0.0.1:8000/health
#
# TODO yang WAJIB diisi:
#   1. ADMIN_TOKEN     → openssl rand -hex 32
#   2. TEST_AUTH_TOKEN → auth_token akun bot (40 hex)
#   3. DM_PIN          → PIN XChat akun bot (4-8 digit)
# Sisanya sudah dituning untuk pola kerja bot menfess.
# ══════════════════════════════════════════════════════════════════════

# ── Keamanan ────────────────────────────────────────────────────────
# TODO 1: kunci /admin/stats. Generate: openssl rand -hex 32
ADMIN_TOKEN=
# Token hanya lewat header Authorization (query string bocor di access log).
ALLOW_QUERY_AUTH=0
# Payload mentah GraphQL dimatikan di produksi.
ENABLE_RAW=0
# Bot server-side → CORS tidak diperlukan.
ALLOWED_ORIGINS=

# ── Jaringan ────────────────────────────────────────────────────────
# API + bot di mesin yang sama; akses eksternal via SSH tunnel/nginx.
API_HOST=127.0.0.1
# KOSONG bila tidak ada proxy valid (proxy lama balas 407 → semua request gagal).
PROXY_LIST=
# Media menfess langsung tanpa proxy (hemat kuota).
MEDIA_PROXY_EXEMPT=1

# ── Playwright / browser ────────────────────────────────────────────
# WAJIB 1: DM kiriman menfess adalah XChat E2EE (dm_pin) + mentions/search
# fallback. Butuh Chromium (deploy.sh sudah install).
PLAYWRIGHT_ENABLED=1
# Bot memproses berurutan — 1 halaman cukup, hemat RAM (~300MB).
PLAYWRIGHT_MAX_CONCURRENT=1
# User lookup cukup lewat cache/GraphQL; browser fallback tidak perlu.
PLAYWRIGHT_FALLBACK=0

# ── XChat E2EE (profil persist) ─────────────────────────────────────
# 1 akun bot → 2 context cadangan (LRU aman; unlock state ada di disk).
XCHAT_PERSISTENT_MAX=2
# Kosong = <repo>/.xchat_profiles (otomatis, jangan di-commit).
XCHAT_PROFILE_DIR=

# ── Cache & pool (tuned untuk bot polling) ──────────────────────────
# Menfess diproses cepat; cache 15 detik menghindari balasan basi.
RESPONSE_CACHE_TTL=15
# 1-2 token cukup; 20 session lebih dari cukup.
CLIENT_POOL_MAX=20
CLIENT_POOL_TTL=600

# ── Retry upstream (biarkan default) ────────────────────────────────
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=8

# ── Body & media ────────────────────────────────────────────────────
# Menfess sering berisi screenshot/gambar menfess → media cap default 50MB.
MAX_BODY_SIZE=1048576
MEDIA_UPLOAD_MAX_BYTES=52428800

# ── Rate limit lokal (per token) ────────────────────────────────────
RATE_LIMIT_PER_TOKEN=100
RATE_LIMIT_BURST=200
RATE_LIMIT_MAX_TOKENS=10000

# ── Server & log ────────────────────────────────────────────────────
# Cache per-worker — jangan naikkan.
WEB_CONCURRENCY=1
LOG_LEVEL=INFO

# ── Script helper (fetch_dm_pin.py) ─────────────────────────────────
# TODO 2: auth_token akun bot (40 hex lower). JANGAN di-commit.
TEST_AUTH_TOKEN=
# TODO 3: PIN XChat akun bot. JANGAN di-commit.
DM_PIN=

# ══════════════════════════════════════════════════════════════════════
# SISI BOT menfessllm — bukan untuk file ini; taruh di env project bot:
#
#   XAPI_BASE_URL=http://127.0.0.1:8000
#   XAPI_TOKEN=<auth_token akun bot>
#   DM_PIN=<pin XChat>
#
# Pola panggilan (header, BUKAN query string):
#   H = {"Authorization": f"Bearer {XAPI_TOKEN}", "X-DM-Pin": DM_PIN}
#   GET  /2/users/{bot_id}/mentions?max_results=20          # mention masuk
#   GET  /2/chat/conversations?max_results=20               # DM menfess (E2EE)
#   GET  /2/dm_conversations/{id}/dm_events                 # isi percakapan
#   POST /2/tweets {"text": "...", "reply_to": "<tweet_id>"} # balas
#   POST /2/dm_conversations/with/{user_id}/messages {"text": "..."}
#   POST /2/media/upload?media_type=image/jpeg              # lampiran
# ══════════════════════════════════════════════════════════════════════
